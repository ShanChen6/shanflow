# NestJS runtime (defaults: development, 3001).
NODE_ENV=development
PORT=3001

# Docker bootstrap/provisioning only; not required by NestJS runtime.
POSTGRES_DB=shanflow
POSTGRES_USER=shanflow
# Required: set a local development password in .env, never commit it.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Separate credentials for role provisioning (minimum 16 printable ASCII chars).
# Required only when creating a role; reruns never change existing passwords.
POSTGRES_APP_PASSWORD=
POSTGRES_MIGRATOR_PASSWORD=

# Prisma runtime: shanflow_app; Prisma CLI: shanflow_migrator.
# URL-encode username/password; use the configured POSTGRES_PORT and ?schema=public.
DATABASE_URL=
DIRECT_DATABASE_URL=
# Development only: shanflow_migrator on shanflow_shadow, never shanflow.
SHADOW_DATABASE_URL=

# Auth (Phase 3). Read by the auth module once it is wired; fail-fast if invalid.
# Required: random signing key, at least 32 characters, e.g. `openssl rand -base64 48`. Never commit.
JWT_ACCESS_SECRET=
JWT_ISSUER=shanflow-api
JWT_AUDIENCE=shanflow-web
# Access token lifetime 60-3600 s (default 900); refresh token lifetime 1-90 days (default 30).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Defaults to true in production (and must be true there); false for local http.
AUTH_COOKIE_SECURE=false
# Optional bare host name; leave empty for a host-only cookie.
AUTH_COOKIE_DOMAIN=
# Web origin for CORS and Origin checks: scheme+host only, https in production.
WEB_ORIGIN=http://localhost:3000

# Web app (Next.js): API origin the browser calls, no trailing slash. Inlined at build time.
NEXT_PUBLIC_API_URL=http://localhost:3001

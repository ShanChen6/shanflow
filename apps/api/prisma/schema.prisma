generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  SUSPENDED

  @@map("account_status")
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String              @unique(map: "users_email_key") @db.Text
  displayName        String              @map("display_name") @db.Text
  avatarUrl          String?             @map("avatar_url") @db.Text
  /// Key of the uploaded avatar in AvatarStorage; takes precedence over avatarUrl (an external provider picture).
  avatarStorageKey   String?             @map("avatar_storage_key") @db.Text
  avatarUpdatedAt    DateTime?           @map("avatar_updated_at") @db.Timestamptz(3)
  accountStatus      AccountStatus       @default(ACTIVE) @map("account_status")
  emailVerifiedAt    DateTime?           @map("email_verified_at") @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  ownedWorkspaces    Workspace[]         @relation("WorkspaceOwner")
  memberships        WorkspaceMember[]   @relation("MembershipUser")
  passwordCredential PasswordCredential?
  refreshSessions    RefreshSession[]
  oauthAccounts      OAuthAccount[]
  oneTimeTokens      OneTimeToken[]

  @@map("users")
}

enum WorkspaceType {
  PERSONAL
  TEAM

  @@map("workspace_type")
}

model Workspace {
  id        String            @id @default(uuid()) @db.Uuid
  name      String            @db.Text
  ownerId   String            @map("owner_id") @db.Uuid
  type      WorkspaceType     @default(PERSONAL)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner     User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  members   WorkspaceMember[] @relation("WorkspaceMembership")
  projects  Project[]         @relation("WorkspaceProjects")
  tasks     Task[]            @relation("WorkspaceTasks")

  // PERSONAL uniqueness is a manual partial index in add_workspace.
  @@index([ownerId], map: "workspaces_owner_id_idx")
  @@map("workspaces")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER

  @@map("workspace_role")
}

enum MembershipStatus {
  ACTIVE
  INACTIVE

  @@map("membership_status")
}

model WorkspaceMember {
  id               String           @id @default(uuid()) @db.Uuid
  workspaceId      String           @map("workspace_id") @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  role             WorkspaceRole    @default(MEMBER)
  membershipStatus MembershipStatus @default(ACTIVE) @map("membership_status")
  joinedAt         DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace        Workspace        @relation("WorkspaceMembership", fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user             User             @relation("MembershipUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdTasks     Task[]           @relation("TaskCreatorMembership")
  assignedTasks    Task[]           @relation("TaskAssigneeMembership")

  // At-most-one OWNER (including INACTIVE) is a manual partial index.
  // Matching ACTIVE ownership still requires the ADR-011 service protocol.
  @@unique([workspaceId, userId], map: "workspace_members_workspace_id_user_id_key")
  @@index([userId, membershipStatus, workspaceId], map: "workspace_members_user_status_workspace_idx")
  @@index([workspaceId, membershipStatus], map: "workspace_members_workspace_status_idx")
  @@map("workspace_members")
}

model Project {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  name        String    @db.Text
  description String?   @db.Text
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  color       String?   @db.Text
  icon        String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace   Workspace @relation("WorkspaceProjects", fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  tasks       Task[]    @relation("TaskProject")

  // Future Task(workspaceId, projectId) uses this all-row FK target.
  @@unique([workspaceId, id], map: "projects_workspace_id_id_key")
  @@index([workspaceId, archivedAt, createdAt, id], map: "projects_workspace_archive_created_id_idx")
  @@map("projects")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELED

  @@map("task_status")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("task_priority")
}

model Task {
  id                 String           @id @default(uuid()) @db.Uuid
  workspaceId        String           @map("workspace_id") @db.Uuid
  projectId          String?          @map("project_id") @db.Uuid
  title              String           @db.Text
  description        String?          @db.Text
  status             TaskStatus       @default(TODO)
  priority           TaskPriority     @default(MEDIUM)
  dueAt              DateTime?        @map("due_at") @db.Timestamptz(3)
  assigneeId         String?          @map("assignee_id") @db.Uuid
  createdById        String           @map("created_by_id") @db.Uuid
  position           BigInt           @db.BigInt
  version            Int              @default(1) @db.Integer
  completedAt        DateTime?        @map("completed_at") @db.Timestamptz(3)
  deletedAt          DateTime?        @map("deleted_at") @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace          Workspace        @relation("WorkspaceTasks", fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  project            Project?         @relation("TaskProject", fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction)
  creatorMembership  WorkspaceMember  @relation("TaskCreatorMembership", fields: [workspaceId, createdById], references: [workspaceId, userId], onDelete: Restrict, onUpdate: NoAction)
  assigneeMembership WorkspaceMember? @relation("TaskAssigneeMembership", fields: [workspaceId, assigneeId], references: [workspaceId, userId], onDelete: Restrict, onUpdate: NoAction)

  // Live lane uniqueness and query-only partial indexes are manual migration SQL.
  @@unique([workspaceId, id], map: "tasks_workspace_id_id_key")
  @@index([workspaceId, projectId], map: "tasks_workspace_project_idx")
  @@index([workspaceId, createdById], map: "tasks_workspace_creator_idx")
  @@index([workspaceId, assigneeId], map: "tasks_workspace_assignee_idx")
  @@map("tasks")
}

model PasswordCredential {
  userId            String   @id @map("user_id") @db.Uuid
  passwordHash      String   @map("password_hash") @db.Text
  passwordUpdatedAt DateTime @default(now()) @map("password_updated_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  // CHECK (password_hash <> '') is a manual constraint in add_auth_storage.
  @@map("password_credentials")
}

model RefreshSession {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  familyId     String          @map("family_id") @db.Uuid
  tokenHash    String          @unique(map: "refresh_sessions_token_hash_key") @map("token_hash") @db.Text
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime        @map("expires_at") @db.Timestamptz(3)
  usedAt       DateTime?       @map("used_at") @db.Timestamptz(3)
  revokedAt    DateTime?       @map("revoked_at") @db.Timestamptz(3)
  replacedById String?         @unique(map: "refresh_sessions_replaced_by_id_key") @map("replaced_by_id") @db.Uuid
  lastUsedAt   DateTime?       @map("last_used_at") @db.Timestamptz(3)
  deviceLabel  String?         @map("device_label") @db.Text
  user         User            @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  replacedBy   RefreshSession? @relation("RefreshRotation", fields: [replacedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  replaces     RefreshSession? @relation("RefreshRotation")

  // Format/lifecycle CHECK constraints are manual in add_auth_storage.
  // Successor same-user/family is enforced by the rotation transaction (ADR-010).
  @@index([userId], map: "refresh_sessions_user_id_idx")
  @@index([familyId], map: "refresh_sessions_family_id_idx")
  @@index([expiresAt], map: "refresh_sessions_expires_at_idx")
  @@map("refresh_sessions")
}

enum OAuthProvider {
  GOOGLE

  @@map("oauth_provider")
}

model OAuthAccount {
  id                    String        @id @default(uuid()) @db.Uuid
  userId                String        @map("user_id") @db.Uuid
  provider              OAuthProvider
  providerAccountId     String        @map("provider_account_id") @db.Text
  providerEmail         String?       @map("provider_email") @db.Text
  providerEmailVerified Boolean?      @map("provider_email_verified")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                  User          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  // The provider's stable subject is the identity key; email is never used for linking (ADR-010).
  // A user links at most one account per provider. CHECK (btrim(provider_account_id) <> '') is manual.
  @@unique([provider, providerAccountId], map: "oauth_accounts_provider_account_key")
  @@unique([userId, provider], map: "oauth_accounts_user_provider_key")
  @@map("oauth_accounts")
}

enum OneTimeTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("one_time_token_purpose")
}

model OneTimeToken {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  purpose   OneTimeTokenPurpose
  /// Email being verified (EMAIL_VERIFICATION only): a token stops working if the account email changes.
  email     String?             @db.Text
  tokenHash String              @unique(map: "one_time_tokens_token_hash_key") @map("token_hash") @db.Text
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime            @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?           @map("used_at") @db.Timestamptz(3)
  user      User                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  // Format/lifecycle CHECK constraints are manual in add_oauth_and_one_time_tokens.
  @@index([userId, purpose], map: "one_time_tokens_user_purpose_idx")
  @@index([expiresAt], map: "one_time_tokens_expires_at_idx")
  @@map("one_time_tokens")
}
